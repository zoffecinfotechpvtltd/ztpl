# Contact form email delivery (Google Workspace SMTP).
# Copy to .env on the server and pass to Docker with:  docker run --env-file .env ...
#
# SMTP_USER  the Workspace mailbox that sends the mail (e.g. support@ztplsolutions.com)
# SMTP_PASS  a Google *app password* for that mailbox (Account > Security > 2-Step Verification > App passwords),
#            not the normal login password.
SMTP_USER=support@ztplsolutions.com
SMTP_PASS=

# Optional overrides (defaults shown)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# CONTACT_TO=support@ztplsolutions.com
